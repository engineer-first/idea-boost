{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!out",
      "!build",
      "!coverage",
      "!storybook-static",
      "!schema-diagrams",
      "!**/*.tsbuildinfo",
      "!next-env.d.ts",
      "!package-lock.json",
      "!public",
      "!docs/site",
      "!.eval-loop",
      "!.open-next",
      "!.claude/worktrees",
      "!.wrangler",
      "!**/.wrangler",
      "!workers/worker-configuration.d.ts",
      "!app/design-tokens.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "style": { "noHexColors": "info" },
      "nursery": { "noTailwindRawColors": "info" }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.stories.tsx",
        "**/*.fixture.ts",
        "tests/**"
      ],
      "linter": {
        "rules": {
          "style": { "noHexColors": "off" },
          "nursery": { "noTailwindRawColors": "off" }
        }
      }
    },
    {
      "includes": [
        "features/landing/molecules/landing.module.css",
        "features/room/molecules/step-guide-illustration.tsx"
      ],
      "linter": {
        "rules": {
          "style": { "noHexColors": "off" },
          "nursery": { "noTailwindRawColors": "off" }
        }
      }
    },
    {
      "includes": [
        "features/room/organisms/room-board-canvas.tsx",
        "features/room/organisms/room-board-header.tsx"
      ],
      "linter": {
        "rules": { "nursery": { "noTailwindRawColors": "off" } }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
