{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(shell|local_shell|apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/format-changed-files.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
