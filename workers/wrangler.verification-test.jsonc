{
  "name": "idea-flow-verification-test",
  "main": "verification-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "VerificationRoomDO" },
      { "name": "ACCOUNT_DO", "class_name": "VerificationAccountDO" },
      {
        "name": "VERIFICATION_WORKSPACE",
        "class_name": "VerificationWorkspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VerificationRoomDO", "VerificationWorkspace"]
    },
    { "tag": "v2", "new_sqlite_classes": ["VerificationAccountDO"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "verification-test",
      "database_id": "verification-test",
      "migrations_dir": "migrations"
    }
  ]
}
