{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // api-worker: D1（ロビー）と RoomDO（ルームの中身）への唯一の入口。
  // テスト (vitest-pool-workers)・ローカル開発 (npm run dev:api)・デプロイの
  // すべてでこの構成を使う。
  "name": "idea-flow-api",
  "main": "api-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ROOM_DO", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idea-flow-lobby",
      // ローカル開発・テストでは placeholder のままでよい。
      // デプロイ時は `wrangler d1 create idea-flow-lobby` の ID に置き換える。
      "database_id": "8e57430c-fd84-4b6d-b9b3-62b4c74ee6dd",
      "migrations_dir": "migrations"
    }
  ]
  // SESSION_SECRET は vars に置かない（vars は secret put で上書きしない限り
  // 本番へ適用され、秘密の平文コミットは事故になる）。
  //   - ローカル開発: `.dev.vars`（gitignore 済み。`.dev.vars.example` を参照）
  //   - テスト: vitest.workers.config.mts の miniflare bindings で注入
  //   - 本番: `wrangler secret put SESSION_SECRET`
}
