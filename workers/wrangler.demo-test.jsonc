{
  "name": "idea-flow-demo-test",
  "main": "demo-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ROOM_DO", "class_name": "DemoRoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoRoomDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "demo-test",
      "database_id": "demo-test",
      "migrations_dir": "migrations"
    }
  ]
}
