{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "idea-boost-pbi-priority",
  "main": "worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["ISSUE_PROJECT_APP_CLIENT_ID", "ISSUE_PROJECT_APP_PRIVATE_KEY"]
  }
}
