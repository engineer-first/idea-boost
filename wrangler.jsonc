{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Next.js アプリ本体の Worker。/api/* は api-worker（workers/wrangler.jsonc）へ
  // サービスバインディングで転送する。ローカルで両方を同時に動かす場合は
  // `npm run preview:cf`（wrangler dev の複数構成起動）を使う。
  "name": "idea-flow-app",
  "account_id": "b50fc9e60dea7830912d07e616822266",
  "main": "workers/app-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // エラー・例外・console 出力を Workers Logs に残し、本番の不具合を後から追う（#635）。
  // 全件収集。保存は7日で、閲覧できるのは Cloudflare アカウントのメンバーだけ。
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://ideaboost.dev"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "API_WORKER",
      "service": "idea-flow-api"
    }
  ],
  "routes": [
    {
      "pattern": "ideaboost.dev",
      "zone_name": "ideaboost.dev",
      "custom_domain": true
    }
  ]
}
