{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canvas rule index (generated, not authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "source",
    "sourceSha256",
    "implementationBaseline",
    "authority",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "source": {
      "const": "../canvas-interactions.md"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementationBaseline": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "authority": {
      "const": "markdown"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "anchor",
          "status",
          "acceptanceId",
          "contract",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CI-[A-Z0-9]+-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string"
          },
          "status": {
            "enum": ["inherited", "v1", "future", "pending"]
          },
          "acceptanceId": {
            "type": "string",
            "pattern": "^AT-[0-9]{3}$"
          },
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "区分",
              "状態",
              "入力",
              "主体・工程",
              "対象・前提",
              "結果",
              "取消",
              "失敗",
              "同時操作",
              "検証"
            ],
            "properties": {
              "区分": {
                "type": "string",
                "minLength": 1
              },
              "状態": {
                "type": "string",
                "minLength": 1
              },
              "入力": {
                "type": "string",
                "minLength": 1
              },
              "主体・工程": {
                "type": "string",
                "minLength": 1
              },
              "対象・前提": {
                "type": "string",
                "minLength": 1
              },
              "結果": {
                "type": "string",
                "minLength": 1
              },
              "取消": {
                "type": "string",
                "minLength": 1
              },
              "失敗": {
                "type": "string",
                "minLength": 1
              },
              "同時操作": {
                "type": "string",
                "minLength": 1
              },
              "検証": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
