{
  "name": "idea-boost",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --no-warnings scripts/dev-server.mts -- node_modules/next/dist/bin/next dev",
    "dev:persistent": "node --no-warnings scripts/dev-server.mts --persistent -- node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:boundaries": "ast-grep scan",
    "check:feature-layout": "node --no-warnings scripts/check-feature-layout.mts",
    "check:agent-harness": "node --no-warnings scripts/check-agent-harness.mts",
    "check:migrations": "bash scripts/check-migration-numbers.sh",
    "check:room-do-migrations:immutable": "node scripts/check-room-do-migration-immutability.mjs",
    "fix": "biome check --write",
    "format": "biome format --write",
    "format:md": "remark . --ext md --quiet --frail --output",
    "cf-typegen": "wrangler types --config workers/wrangler.jsonc workers/worker-configuration.d.ts",
    "typecheck": "npm run cf-typegen && tsc --noEmit && tsc -p workers/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "pretest:workers": "npm run gen:room-do-migrations",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "predev:api": "npm run gen:room-do-migrations && npm run db:migrate",
    "dev:api": "node --no-warnings scripts/dev-server.mts -- node_modules/wrangler/bin/wrangler.js dev --config workers/wrangler.jsonc",
    "predev:api:persistent": "npm run gen:room-do-migrations && npm run db:migrate",
    "dev:api:persistent": "node --no-warnings scripts/dev-server.mts --persistent -- node_modules/wrangler/bin/wrangler.js dev --config workers/wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --local --config workers/wrangler.jsonc",
    "db:schema:d1": "node --no-warnings scripts/build-d1-schema.mts",
    "db:schema:room-do": "node --no-warnings scripts/build-room-do-schema.mts",
    "db:schema:diagrams": "npm run db:schema:d1 && npm run db:schema:room-do && tbls doc --config .tbls/d1.yml --rm-dist && tbls doc --config .tbls/room-do.yml --rm-dist",
    "db:schema:lint": "npm run db:schema:d1 && npm run db:schema:room-do && tbls lint --config .tbls/d1.yml && tbls lint --config .tbls/room-do.yml",
    "deps:diagrams": "node --no-warnings scripts/build-dependency-diagrams.mts",
    "postinstall": "npm run gen:room-do-migrations",
    "gen:room-do-migrations": "node scripts/generate-room-do-migrations.mjs",
    "new:room-do-migration": "node scripts/new-room-do-migration.mjs",
    "predeploy:api": "npm run gen:room-do-migrations",
    "deploy:api": "wrangler deploy --config workers/wrangler.jsonc",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:app": "npm run build:cf && wrangler deploy -c wrangler.jsonc",
    "deploy:migrate": "wrangler d1 migrations apply DB --remote --config workers/wrangler.jsonc",
    "deploy": "node scripts/deploy-production.mts deploy",
    "prepreview:cf": "npm run gen:room-do-migrations",
    "preview:cf": "opennextjs-cloudflare build && wrangler dev -c wrangler.jsonc -c workers/wrangler.jsonc",
    "presmoke": "npm run gen:room-do-migrations",
    "smoke": "bash scripts/smoke-test.sh",
    "storybook": "npm run db:schema:diagrams && npm run deps:diagrams && storybook dev -p 6006",
    "build-storybook": "npm run db:schema:diagrams && npm run deps:diagrams && storybook build",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "dev:verify": "node --no-warnings scripts/dev-server.mts -- scripts/verification.mts",
    "dev:verify:persistent": "node --no-warnings scripts/dev-server.mts --persistent -- scripts/verification.mts",
    "test:verification": "npm run gen:room-do-migrations && vitest run --config vitest.verification.config.mts",
    "release:record": "node scripts/release-history.mts",
    "release:submit": "node scripts/deploy-production.mts submit",
    "release:operator": "node scripts/release-operator.mts",
    "access:grant": "node --no-warnings scripts/access.mts grant",
    "access:revoke": "node --no-warnings scripts/access.mts revoke",
    "access:list": "node --no-warnings scripts/access.mts list",
    "feedback:delete": "node --no-warnings scripts/feedback.mts delete",
    "pretest:preview": "npm run gen:room-do-migrations",
    "test:preview": "vitest run --config vitest.preview.config.mts",
    "build:preview": "opennextjs-cloudflare build --config wrangler.preview.jsonc"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@opennextjs/cloudflare": "^1.20.12",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "chromatic": "^18.13.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "mermaid": "^12.2.0",
    "miniflare": "4.20260730.0",
    "msw": "^3.0.3",
    "playwright": "^1.64.1",
    "remark-cjk-friendly": "^2.3.2",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.0",
    "storybook": "^10.6.2",
    "string-width": "^8.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  },
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "npm@11.19.1"
}
