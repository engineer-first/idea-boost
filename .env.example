# --- セッション ---
# セッショントークンの署名秘密。api-worker 側（workers/.dev.vars）と
# 一致させること。HS256 の鍵として 32 バイト以上の UTF-8 文字列が必要。
# git 履歴の既知値以外にすること。本番は `wrangler secret put SESSION_SECRET` で設定。
SESSION_SECRET=local-dev-secret-please-change-me-1234
# ↑ この値は denylist 入り（KNOWN_INSECURE_SECRETS）で実行時に拒否される。
# ローカル開発時は `.env.local` に 32 バイト以上の別のランダム値を設定すること。

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- api-worker ---
# ローカル開発では `npm run dev:api` で起動したワーカーへ HTTP で到達する。
# Cloudflare 上ではサービスバインディングが使われるため設定不要。
API_WORKER_URL=http://localhost:8787
# ブラウザからの WebSocket 接続先（未設定なら同一オリジンの /api/... を使う）
NEXT_PUBLIC_API_WORKER_URL=http://localhost:8787

# --- 認証 ---
# 開発用固定ユーザー（owner/member/viewer@example.test / password）でのログイン
NEXT_PUBLIC_ENABLE_DEV_AUTH=true

# Google ログイン（本番相当の動作確認をする場合のみ）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MSW ---
NEXT_PUBLIC_USE_MSW=false
