{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "security:minimumReleaseAgeNpm"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am"],
  "labels": ["dependencies"],
  "prHourlyLimit": 0,
  "dependencyDashboard": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "1.0以上のパッチを1つのPRにまとめ、developの必須チェックが成功した後にGitHubのauto-mergeで取り込む (#395)",
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "packageManager",
        "tools"
      ],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "patch updates",
      "automerge": true
    },
    {
      "description": "1.0以上のマイナーを1つのPRにまとめ、developの必須チェックが成功した後にGitHubのauto-mergeで取り込む。本番公開前の確認はreleaseスキルで行う (#395)",
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "packageManager",
        "tools"
      ],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "minor updates",
      "automerge": true
    },
    {
      "description": "overridesは脆弱性対応で固定した版。lockfileの別の版と比べてパッチと誤判定されるため、Dashboardで承認した時だけ更新する（docs/development/dependencies.md の限定override）",
      "matchDepTypes": ["overrides"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "TypeScript 6/7はStorybook内部のtsconfckのpeer条件とCompiler API依存の確認 (#738) が済むまでPRを作らない。#738を閉じたらこのルールを外す",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
